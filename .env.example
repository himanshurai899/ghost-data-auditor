# Copy to .env (gitignored) and fill in. Never commit real values.
# NVIDIA build keys are account-scoped: NVIDIA_API_KEY alone works for every model.
# The per-endpoint overrides are optional (separate keys make revocation more granular).
NVIDIA_API_KEY=
NVIDIA_API_KEY_EMBED=
NVIDIA_API_KEY_EMBED_LARGE=
NVIDIA_API_KEY_RERANK=
NVIDIA_API_KEY_PARSE=
NVIDIA_API_KEY_CHAT=

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
RETRIEVAL_BASE_URL=https://ai.api.nvidia.com/v1/retrieval
LLM_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODEL_REASON=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
GUARD_MODEL=nvidia/llama-3.1-nemoguard-8b-topic-control
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
EMBED_MODEL_LARGE=nvidia/nemotron-3.5-embed-8b
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
PARSE_MODEL=nvidia/nemotron-3.5-parse
LLM_RPM=35
LLM_MAX_CALLS=400
